{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RepoBeacon assessment v1.0",
  "type": "object",
  "required": ["schema_version", "application_version", "created_at", "target", "scanner_runs", "coverage", "findings", "policy_result"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "application_version": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "target": {"type": "object", "required": ["path", "identity", "snapshot_sha256"]},
    "scanner_runs": {"type": "array", "items": {"type": "object", "required": ["scanner", "required", "status"], "properties": {"scanner": {"type": "string"}, "required": {"type": "boolean"}, "status": {"enum": ["success", "partial", "error", "missing", "not_applicable", "unsupported"]}}}},
    "coverage": {"type": "object"},
    "findings": {"type": "array", "items": {"type": "object", "required": ["id", "fingerprint", "category", "severity", "locations", "observations", "baseline_state"], "properties": {"id": {"type": "string"}, "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "category": {"enum": ["sast", "secret", "sca", "iac", "container", "kubernetes", "license"]}, "severity": {"enum": ["critical", "high", "medium", "low", "info", "unknown"]}, "locations": {"type": "array", "minItems": 1}, "observations": {"type": "array", "minItems": 1}, "baseline_state": {"enum": ["new", "existing", "not comparable"]}}}},
    "policy_result": {"type": "object", "required": ["execution_status", "policy_status", "exit_code"], "properties": {"execution_status": {"enum": ["complete", "incomplete"]}, "policy_status": {"enum": ["pass", "fail"]}, "exit_code": {"enum": [0, 1, 2]}}}
  }
}
